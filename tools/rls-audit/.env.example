# ─────────────────────────────────────────────────────────────────────────────
#  انسخ هذا الملف إلى .env ثمّ عبّئ القيم من Supabase → Project Settings → API.
#  ⚠️ لا تدفع ملف .env أبداً (محميّ بـ .gitignore). المفتاح service_role يتجاوز
#     كل سياسات RLS — عامله كـ«مفتاح ماستر»، لا يظهر في أي متصفّح ولا مستودع.
# ─────────────────────────────────────────────────────────────────────────────

# مطلوب لكل الفحوصات (RLS + الباغات)
SUPABASE_URL=https://xocrzpjfvizgnsybegwr.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...          # المفتاح العلني (anon/public)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # مفتاح الخدمة — للبذر والتنظيف فقط

# مطلوب لفحص الأداء فقط (EXPLAIN ANALYZE + كشف الفهارس الناقصة).
# من Supabase → Project Settings → Database → Connection string → "Session pooler".
# يُنصح باستعمال مستخدم للقراءة فقط إن أمكن.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# اختياري: السنة الدراسية المستعملة في بيانات الاختبار (افتراضي 2025-2026)
AUDIT_ACADEMIC_YEAR=2025-2026
